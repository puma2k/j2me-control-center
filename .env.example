BIND_ADDRESS=127.0.0.1
PORT=3000
ADMIN_USERNAME=admin
# Required: choose a unique password with at least 12 characters.
ADMIN_PASSWORD=replace-with-a-long-unique-password
MAX_INSTANCES=5
# Admission estimate reserves heap + 128 MB overhead per JVM.
MEMORY_BUDGET_MB=2048
CONTAINER_MEMORY=3g
CONTAINER_CPUS=2.0
START_TIMEOUT_SECONDS=60
STREAM_FPS=60
STREAM_QUALITY=60
SESSION_TTL_SECONDS=28800
# For HTTPS deployment: true and your exact HTTPS origin.
COOKIE_SECURE=false
PUBLIC_ORIGIN=
